{
  "name": "pizzeria-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "Pizzas and ingredients microservices, each with its own web server and database",
  "workspaces": [
    "ingredients-service",
    "pizzas-service"
  ],
  "scripts": {
